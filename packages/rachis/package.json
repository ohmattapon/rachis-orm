{
  "name": "rachis-orm",
  "version": "0.1.0",
  "description": "A small TypeScript ORM for Bun + PostgreSQL. No decorators, no codegen, no magic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohmattapon/rachis-orm.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pg": "./src/adapter-pg.ts",
    "./package.json": "./package.json"
  },
  "files": ["src", "LICENSE", "README.md"],
  "scripts": {
    "test": "bun test ./tests/",
    "typecheck": "bunx tsc --noEmit -p ./tsconfig.json"
  },
  "dependencies": {
    "zod": "^3"
  },
  "peerDependencies": {
    "pg": "^8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pg": "^8",
    "pg": "^8"
  }
}
